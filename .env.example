# Copy to .env and fill in. Never commit the real .env.

ANTHROPIC_API_KEY=

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable once the study starts — rotating it strands every
# participant's stored token and they'd need to reconnect.
TOKEN_ENCRYPTION_KEY=

# Shared secret for the /admin/* review endpoints (approve/reject
# proposed calendar events). Pick a long random string.
ADMIN_TOKEN=

# Path to the "Web application" OAuth client secret JSON downloaded from
# Google Cloud Console (Credentials -> the client used for this study;
# NOT the "Desktop app" one used by test_gmail.py / credentials.json).
GOOGLE_OAUTH_CLIENT_SECRETS_PATH=oauth_client_secret.json

# Must exactly match a redirect URI registered on that OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

STUDY_DB_PATH=study.db
POLL_INTERVAL_SECONDS=30
